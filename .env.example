# =============================================================================
# upay Corporate Assist - Global Environment Configuration Reference
# =============================================================================

# --- BACKEND CONFIGURATION (backend/.env) ---
PORT=5000
FLASK_ENV=development
SECRET_KEY=replace_with_a_unique_32_plus_character_secret
JWT_SECRET_KEY=replace_with_a_unique_32_plus_character_jwt_secret
JWT_EXPIRATION_HOURS=24
DEMO_SEED_PASSWORD=choose_a_local_development_password

# Mandatory PostgreSQL Database Connection
DATABASE_URL=postgresql://localhost:5432/upay_corporate_assist

# --- FRONTEND CONFIGURATION (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api
NEXT_PUBLIC_APP_NAME=upay Corporate Assist
