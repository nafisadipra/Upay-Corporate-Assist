# Flask Application Environment Configuration Example
PORT=5000
HOST=127.0.0.1
FLASK_ENV=development
SECRET_KEY=replace_with_a_unique_32_plus_character_secret
JWT_SECRET_KEY=replace_with_a_unique_32_plus_character_jwt_secret
JWT_EXPIRATION_HOURS=24
# Separate cookies let the corporate and admin portals stay signed in together.
CORPORATE_AUTH_COOKIE_NAME=upay_corporate_session
ADMIN_AUTH_COOKIE_NAME=upay_admin_session
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
RATELIMIT_STORAGE_URI=memory://

# Mandatory PostgreSQL Database Configuration
DATABASE_URL=postgresql://localhost:5432/upay_corporate_assist

# Storage & File Uploads
UPLOAD_FOLDER=uploads

# Required only when running `python run.py --seed` for local demonstration data.
DEMO_SEED_PASSWORD=choose_a_local_development_password
